# ==============================================================================
# MINIMI WEB SEARCH CHAT AGENT - CONFIGURATION & API KEYS
# ==============================================================================
# All keys are optional: If no keys are provided, the agent automatically runs
# using DuckDuckGo search fallback and deterministic grounded synthesis.
# For production quality, configure at least one Search Key and one LLM Key.

# ------------------------------------------------------------------------------
# 1. WEB SEARCH TOOL (Choose one or more)
# ------------------------------------------------------------------------------
# Tavily Search API (Recommended - AI-native search with clean snippet extraction)
# Get a key at https://tavily.com
TAVILY_API_KEY=

# Brave Search API (Alternative independent web index)
# Get a key at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Serper API (Google Search SERP)
# Get a key at https://serper.dev
SERPER_API_KEY=

# Note: If no search keys are specified, the agent seamlessly uses DuckDuckGo
# zero-config search so `npm run dev` works out of the box with zero setup!

# ------------------------------------------------------------------------------
# 2. LLM INFERENCE PROVIDER (Choose one or more)
# ------------------------------------------------------------------------------
# OpenAI (Default: gpt-4o-mini)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Groq (Ultra-low latency inference, e.g. llama-3.3-70b-versatile)
# GROQ_API_KEY=

# Google Gemini (Gemini 2.0 / Flash)
# GEMINI_API_KEY=

# Anthropic Claude (Claude 3.5 Sonnet)
# ANTHROPIC_API_KEY=

# Custom OpenAI-Compatible Base URL (e.g. Local Ollama, vLLM, OpenRouter)
# OPENAI_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 3. TEMPORAL GROUNDING SIMULATION (Optional)
# ------------------------------------------------------------------------------
# Set to anchor the "current" system date for reproducible evaluation benchmark tests.
# If left blank, the agent defaults to system wall-clock time.
# SIMULATED_CURRENT_DATE=2026-11-13T10:00:00Z
